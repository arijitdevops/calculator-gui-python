# Copy this file to .env and edit it, or set the variables in your shell.
# PyCalculator reads these with os.environ at start-up; every one is optional.

# Where the calculation history is stored.
# Default: %APPDATA%\PyCalculator\history.json on Windows,
#          ~/.config/pycalculator/history.json on Linux,
#          ~/Library/Application Support/PyCalculator/history.json on macOS.
CALCULATOR_HISTORY_FILE=

# Maximum number of history entries kept on disk. Default: 100
CALCULATOR_HISTORY_LIMIT=100

# Start-up theme: light or dark. Default: light
CALCULATOR_THEME=light

# Start-up angle mode: deg or rad. Default: rad
CALCULATOR_ANGLE_MODE=rad

# Logging verbosity: DEBUG, INFO, WARNING, ERROR or CRITICAL. Default: WARNING
CALCULATOR_LOG_LEVEL=WARNING
